datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  username  String   @unique @db.VarChar(30)
  email     String   @unique @db.VarChar(75)
  password  String   @db.VarChar(60)
  photoURL  String?  @db.VarChar(500)
  latitude  Float?
  longitude Float?
  city      String?  @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  books     Book[]
  sentTrades     Trade[] @relation("SentTrades")
  receivedTrades Trade[] @relation("ReceivedTrades")
  tradeMessages  TradeMessage[]
}

model Book {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(255)
  author      String   @db.VarChar(255)
  description String?  @db.Text
  coverURL    String?  @db.VarChar(500)
  language    String?  @db.VarChar(50)
  year        Int?
  userId      String?  @db.Uuid
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  genres      Genre[]
  tradeItems  TradeItem[]
  isForTrade  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Genre {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  books     Book[]
  createdAt DateTime @default(now())
}

enum TradeStatus {
  PENDING
  AGREED
  COMPLETED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum TradeItemSide {
  OFFERED
  REQUESTED
}

model Trade {
  id          String       @id @default(uuid()) @db.Uuid
  senderId    String       @db.Uuid
  sender      User         @relation("SentTrades", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String       @db.Uuid
  receiver    User         @relation("ReceivedTrades", fields: [receiverId], references: [id], onDelete: Cascade)
  status      TradeStatus  @default(PENDING)
  message     String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  items       TradeItem[]
  messages    TradeMessage[]

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model TradeItem {
  id        String        @id @default(uuid()) @db.Uuid
  tradeId   String        @db.Uuid
  trade     Trade         @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  bookId    String        @db.Uuid
  book      Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  side      TradeItemSide

  @@index([tradeId])
  @@index([bookId])
}

model TradeMessage {
  id        String   @id @default(uuid()) @db.Uuid
  tradeId   String   @db.Uuid
  trade     Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  senderId  String   @db.Uuid
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([tradeId])
  @@index([senderId])
}